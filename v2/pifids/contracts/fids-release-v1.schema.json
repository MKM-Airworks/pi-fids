{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mkm:fids-distribution:release:1",
  "title": "MKM FIDS Distribution release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "organizationId",
    "airportId",
    "stationAirport",
    "timezone",
    "releaseId",
    "dataVersion",
    "publishedAt",
    "preview",
    "coverage",
    "declaration",
    "flights"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mkm-fids-distribution/1"
    },
    "product": {
      "const": "pi-fids"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "airportId": {
      "type": "string",
      "format": "uuid"
    },
    "stationAirport": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "releaseId": {
      "type": "string",
      "format": "uuid"
    },
    "dataVersion": {
      "type": "integer",
      "minimum": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "preview": {
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "declaration": {
      "enum": [
        "schedules",
        "no_flights"
      ]
    },
    "flights": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "flightNumber": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2}[0-9]{1,4}[A-Z]?$"
          },
          "airlineCode": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2}$"
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "journeyType": {
            "enum": [
              "domestic",
              "international"
            ]
          },
          "validFrom": {
            "type": "string",
            "format": "date"
          },
          "validTo": {
            "type": "string",
            "format": "date"
          },
          "operatingDays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "OT",
              "DL",
              "HD",
              "FE",
              "NI",
              "CD",
              "DP",
              "LD",
              "RT",
              "DV",
              "NA"
            ]
          },
          "codeshareFlights": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9]{2}[0-9]{1,4}[A-Z]?$"
            },
            "uniqueItems": true,
            "maxItems": 30
          },
          "direction": {
            "enum": [
              "departure",
              "arrival"
            ]
          },
          "scheduledTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "estimatedTime": {
            "type": "string",
            "pattern": "^$|^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "gate": {
            "type": "string",
            "maxLength": 20
          },
          "timeStatus": {
            "enum": [
              "",
              "FE",
              "NI",
              "OT",
              "DL",
              "DP",
              "LD",
              "NO"
            ]
          },
          "boardingStatus": {
            "enum": [
              "",
              "not_started",
              "boarding",
              "final_call",
              "gate_closed"
            ]
          }
        },
        "required": [
          "id",
          "flightNumber",
          "airlineCode",
          "origin",
          "destination",
          "journeyType",
          "validFrom",
          "validTo",
          "operatingDays",
          "status",
          "codeshareFlights",
          "direction",
          "scheduledTime",
          "estimatedTime",
          "gate",
          "timeStatus",
          "boardingStatus"
        ]
      }
    }
  }
}
